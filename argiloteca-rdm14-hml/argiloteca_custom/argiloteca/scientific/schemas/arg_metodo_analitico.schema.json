{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argiloteca.local/schemas/arg_metodo_analitico.schema.json",
  "title": "arg:metodo_analitico",
  "type": "object",
  "additionalProperties": true,
  "required": ["metodo_id", "nome"],
  "properties": {
    "metodo_id": {"type": "string", "minLength": 1},
    "nome": {"type": "string", "minLength": 1},
    "tipo": {
      "type": "string",
      "enum": ["drx", "xrd", "geoquimica", "frx", "icp", "mev", "ftir", "granulometria", "extracao_pdf", "outro"]
    },
    "descricao": {"type": "string"},
    "laboratorio": {"type": "string"},
    "equipamento": {"type": "string"},
    "condicoes_analise": {"type": "string"},
    "versao_processamento": {"type": "string"},
    "fonte_metodo": {"type": "string"},
    "observacoes": {"type": "string"}
  }
}
