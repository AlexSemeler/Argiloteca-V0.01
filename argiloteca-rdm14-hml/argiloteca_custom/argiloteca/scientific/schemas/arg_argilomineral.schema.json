{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argiloteca.local/schemas/arg_argilomineral.schema.json",
  "title": "arg:argilomineral",
  "type": "object",
  "additionalProperties": true,
  "required": ["codigo_amostra"],
  "anyOf": [
    {"required": ["nome"]},
    {"required": ["nome_cientifico_padronizado"]}
  ],
  "properties": {
    "codigo_amostra": {"type": "string", "minLength": 1},
    "nome": {"type": "string"},
    "nome_cientifico_padronizado": {"type": "string"},
    "sinonimos": {"type": "string"},
    "formula_ideal": {"type": "string"},
    "grupo": {"type": "string"},
    "grupo_mineralogico": {"type": "string"},
    "subgrupo_mineralogico": {"type": "string"},
    "descricao": {"type": "string"},
    "descricao_curta": {"type": "string"},
    "estrutura_cristalina": {"type": "string"},
    "classe_estrutural": {"type": "string"},
    "sistema_cristalino": {"type": "string"},
    "classificacao_strunz": {"type": "string"},
    "classificacao_dana": {"type": "string"},
    "propriedades_especiais": {"type": "string"},
    "propriedades_relevantes": {"type": "string"},
    "origem_formacao": {"type": "string"},
    "ambiente_tipico_formacao": {"type": "string"},
    "era_geologica": {"type": "string"},
    "formacao_geologica": {"type": "string"},
    "usos_aplicacoes": {"type": "string"},
    "external_source": {"type": "string"},
    "external_id": {"type": "string"},
    "external_uri": {"type": "string", "format": "uri"},
    "fonte_descricao": {"type": "string"},
    "observacao_proveniencia": {"type": "string"},
    "licenca_fonte": {"type": "string"},
    "data_ultima_sincronizacao": {"type": "string"},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "altitude": {"type": ["number", "null"]}
  }
}
